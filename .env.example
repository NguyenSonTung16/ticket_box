# Database Config (PostgreSQL)
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=ticketbox
DB_PASSWORD=password
DB_NAME=ticketbox_db

# Redis Config (Centralized Cache & Distributed Lock)
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ Config (Message Broker for asynchronous queue)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# MeiliSearch Config (Full-text search for Events/Artists)
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=masterKey

# MongoDB Config
MONGO_URI=mongodb://admin:password@localhost:27017/ticketbox_db?authSource=admin

# JWT Secret (Authentication)
JWT_SECRET=super-secret-key
JWT_EXPIRATION=3600s

# PayPal Sandbox (https://developer.paypal.com)
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_SECRET=your_paypal_secret_here
PAYPAL_WEBHOOK_ID=your_ngrok_paypal_webhook_id_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_MODE=sandbox

# SMTP (Nodemailer — Recommend Gmail App Password for dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=TicketBox <noreply@ticketbox.vn>

# VND to USD Exchange Rate (for PayPal Sandbox demo)
VND_TO_USD_RATE=25000

# --- MinIO Object Storage ----------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=ticketbox_admin
MINIO_ROOT_PASSWORD=ticketbox_secret_2026
MINIO_BUCKET_EVENTS=ticketbox-events
MINIO_BUCKET_ARTISTS=ticketbox-artists
MINIO_BUCKET_CHECKIN=ticketbox-checkin

# New Keys
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET_IMAGES=ticketbox-images
MINIO_BUCKET_CSV=ticketbox-csv-imports
MINIO_PRESIGN_TTL_IMAGES=900
MINIO_PRESIGN_TTL_CSV=3600
MINIO_MAX_SIZE_IMAGES=5242880
MINIO_MAX_SIZE_CSV=524288000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
GEMINI_API_KEY=your_google_gemini_api_key_here
ED25519_PRIVATE_KEY=""
ED25519_PUBLIC_KEY=""
JWT_REFRESH_SECRET=super_jwt_refresh_secret_key_for_testing
